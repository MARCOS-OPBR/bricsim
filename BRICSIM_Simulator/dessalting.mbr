                {
                    "type": "variavel",
                    "x": 418.1427150651748,
                    "y": 204.46465852683124,
                    "tag": "PI001",
                    "casas": 2,
                    "digitos": 2,
                    "z": 0.0,
                    "color": "#000000",
                    "font": "Microsoft Sans Serif,12,-1,5,50,0,0,0,0,0",
                    "id": 2617092809376,
                    "lei": "P_ant=passado(\"PI001.pv\",1,0)\nPmax=13\nif G(\"BOMBA001.PV5\"):\n    valor = P_ant+0.4*(Pmax-P_ant+random.uniform(0,0.5))\nelse:\n    valor=0.9*P_ant",
                    "controle": {
                        "variavel_controlada": false,
                        "Kp": 1.0,
                        "Ki": 0.0,
                        "Kd": 0.0,
                        "modo": "MAN",
