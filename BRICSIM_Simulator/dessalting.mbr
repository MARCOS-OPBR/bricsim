                                                "lhs": "TI002.s",
                                                "name": "TI002_cond_factor",
                                                "rhs": "G(\"TI002.KCOND\") / ( 1.0 + ( max(G(\"F_AGUA.pv\",0.0),0.0) / max(1e-9, G(\"F_AGUA.NOM\",650.0)*G(\"TI002.PHI50\",0.50)) )**G(\"TI002.NEXP\",3.0) )",
                                                "type": "equation"
                                            }
                                        ],
