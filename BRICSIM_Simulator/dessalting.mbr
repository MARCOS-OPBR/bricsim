                {
                    "type": "variavel",
                    "x": 428.0978924144533,
                    "y": 487.4379125437458,
                    "tag": "FC001",
                    "casas": 0,
                    "digitos": 4,
                    "z": 0.0,
                    "color": "#000000",
                    "font": "Microsoft Sans Serif,12,-1,5,50,0,0,0,0,0",
                    "id": 2617092811104,
                    "lei": "",
                    "controle": {
                        "variavel_controlada": true,
                        "Kp": 0.1,
                        "Ki": 2.7e-05,
                        "Kd": 0.0,
                        "modo": "MAN",
                        "sp_tracking": true,
                        "pv_tag": "FC001.pv",
                        "sp_tag": "FC001.sp",
                        "mv_tag": "FC001.mv",
                        "acao": "direta",
                        "mv_write_tag": "FC001MV.mv",
                        "pv_min": 0.0,
                        "pv_max": 7000.0
                    },
                    "alarmes": {
