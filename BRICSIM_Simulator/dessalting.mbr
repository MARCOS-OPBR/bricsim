                {
                    "type": "variavel",
                    "x": 1570.9659650651745,
                    "y": 152.75490852683126,
                    "tag": "SAL001",
                    "casas": 0,
                    "digitos": 2,
                    "z": 0.0,
                    "color": "#000000",
                    "font": "Microsoft Sans Serif,12,-1,5,50,0,0,0,0,0",
                    "id": 2617092810384,
                    "lei": "# ---- Parâmetros\ndt     = 1.0       # s\ntau    = 20.0      # s (inércia da dessalgadora)\nS_in_ref = 300    # ppm de referência do sal de entrada (ajuste)\nS_mid    = 10.0    # ppm desejável em condições de referência\nT_ref  = 102      # °C ref\nL_ref  = 30       # m ref\nalpha  = 3       # expoente efeito de temperatura (T↑ → S_out↓)\nbeta   = 1.5       # expoente efeito de nível (L↑ → S_out↑)\n\n# ---- Leituras\nS_in = G('SAL000.pv', S_in_ref)    # ppm (sal de entrada)\nT    = G('TI001.pv', T_ref)        # °C\nL    = G('LI001.pv', L_ref)        # m (nível no vaso da dessalgadora)\ndP   = G('PDC001.pv', 2.0)         # bar (delta P/platô 1.8–2.3)\n\n# ---- Fatores de processo\n# Temperatura alta ajuda (reduz S_out): f_T < 1 se T > T_ref\nf_T = (T_ref / max(1e-6, T))**alpha\nf_T = max(0.3, min(2.0, f_T))\n\n# Nível alto atrapalha (aumenta S_out)\nf_L = (L / max(1e-6, L_ref))**beta\nf_L = max(0.5, min(2.0, f_L))\n\n# Platô de ΔP 1.8–2.3 → bom; fora disso penaliza\nif dP < 1.8:\n    f_P = 1.0 + 3.0*(1.8 - dP)\nelif dP > 2.3:\n    f_P = 1.0 + 3.0*(dP - 2.3)\nelse:\n    f_P = 1.0\n\n# ---- Alvo físico: proporcional ao SAL000\ngamma    = (S_mid / S_in_ref) * f_T * f_L * f_P   # fator de redução relativo ao S_in\nS_target = S_in * gamma\nS_target = max(1.0, min(S_in, S_target))          # não pode passar do S_in; mínimo 1 ppm\n\n# ---- Dinâmica (1ª ordem)\nS_prev = passado('SAL_OUT.pv', 1, S_mid)\nvalor  = S_prev + dt/tau * (S_target - S_prev)",
                    "controle": {
                        "variavel_controlada": false,
                        "Kp": 1.0,
                        "Ki": 0.0,
                        "Kd": 0.0,
                        "modo": "MAN",
                        "sp_tracking": false,
                        "pv_tag": "SAL001.pv",
                        "sp_tag": "SAL001.sp",
                        "mv_tag": "SAL001.mv",
                        "acao": "direta",
                        "mv_write_tag": "",
                        "pv_min": 0.0,
                        "pv_max": 500.0
                    },
                    "alarmes": {
                        "HH": null,
                        "H": null,
                        "L": null,
                        "LL": null
                    },
                    "tipo": "ANA",
                    "mods": []
                },
