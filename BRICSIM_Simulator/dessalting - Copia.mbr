                    "font": "Microsoft Sans Serif,12,-1,5,50,0,0,0,0,0",
                    "id": 2357715342480,
                    "lei": "# PC001: pressão de topo (bar) reagindo inversamente a PDC001\n\ndt     = 1.0\ntau_P  = 3.0          # resposta rápida\nP_sp   = 3.5         # bar, alvo nominal\ndP_ref = 2.0          # bar, ΔP de referência onde PC = P_sp\nk_inv  = 1         # ganho [bar de PC por bar de (dP_ref - PDC)]\n\nP_prev = passado('PC001.pv', 1, P_sp)\ndP     = G('PDC001.pv', dP_ref)\n\n# Se PDC ↓ (dP < dP_ref), termo (dP_ref - dP) > 0 → P_target sobe\nP_target = P_sp + k_inv * (dP_ref - dP)\n\nvalor = P_prev + dt/tau_P * (P_target - P_prev)",
                    "controle": {
                        "variavel_controlada": false,
                        "Kp": 1.0,
                        "Ki": 0.0,
                        "Kd": 0.0,
                        "modo": "MAN",
                        "sp_tracking": false,
                        "pv_tag": "PC001.pv",
                        "sp_tag": "PC001.sp",
                        "mv_tag": "PC001.mv",
                        "acao": "direta",
                        "mv_write_tag": "",
                        "pv_min": 0.0,
                        "pv_max": 20.0
                    },
                    "alarmes": {
                        "HH": null,
                        "H": null,
                        "L": null,
                        "LL": null
                    },
                    "mods": []
                },
                {
                    "type": "variavel",
                    "x": 867.2860897526748,
                    "y": 561.9986450893309,
                    "tag": "PDC001",
                    "casas": 2,
                    "digitos": 1,
                    "z": 0.0,
                    "color": "#000000",
                    "font": "Microsoft Sans Serif,12,-1,5,50,0,0,0,0,0",
                    "id": 2357715342336,
                    "lei": "# PDC001: ΔP (bar) cai conforme a própria MV (0–100%)\n# usa 1ª ordem pra evitar laço e oscilações\n\ndt       = 1.0\ntau_dP   = 8.0           # s (ajuste a rapidez)\nKGF2BAR  = 0.980665\n\ndP_prev  = passado('PDC001.pv', 1, 2.0)            # bar\nMV       = G('PDC001.mv', 0.0)                     # %\ndP_base  = G('PDC_IN.pv', 5) * KGF2BAR           # bar (ex.: 5 kgf/cm²)\n\nk_drop   = 5           # bar de redução em 100% de abertura (ajuste)\ndP_tgt   = max(0.0, dP_base - k_drop*(MV/100.0))   # maior MV -> menor ΔP\n\nvalor = dP_prev + dt/tau_dP * (dP_tgt - dP_prev)\nvalor = max(0.1, min(10.0, valor))                 # limites de engenharia",
                    "controle": {
                        "variavel_controlada": true,
                        "Kp": 1.0,
                        "Ki": 0.0,
                        "Kd": 0.0,
                        "modo": "MAN",
                        "sp_tracking": true,
                        "pv_tag": "PDC001.pv",
                        "sp_tag": "PDC001.sp",
                        "mv_tag": "PDC001.mv",
                        "acao": "reversa",
                        "mv_write_tag": "",
                        "pv_min": 0.0,
                        "pv_max": 100.0
                    },
                    "alarmes": {
                        "HH": null,
                        "H": null,
                        "L": null,
                        "LL": null
                    },
                    "mods": []
                },
                {
                    "type": "variavel",
                    "x": 1539.8992419265871,
                    "y": 309.73185704585273,
                    "tag": "LI001",
                    "casas": 0,
                    "digitos": 3,
                    "z": 0.0,
                    "color": "#000000",
                    "font": "Microsoft Sans Serif,12,-1,5,50,0,0,0,0,0",
                    "id": 2357715342192,
                    "lei": "# LI001 — nível da dessalgadora\n# Entrada: FC002   | Saída: dependente de LC001.mv (cascata)\n# Ordem sugerida de tipo: \"estado_lento\"\n\ndt  = 1.0      # s\nA   = 15    # m²  (área da seção — ajuste conforme o vaso)\nk_v =0.5     # m³/s por sqrt(m) a 100% de abertura (ajuste)\n\n# Estado anterior\nh_prev = passado('LI001.pv', 1, 1.0)          # m\n\n# Vazão de entrada (ajuste a unidade):\n# Se FC002 estiver em m³/h, converta para m³/s dividindo por 3600:\nQ_in = 650 / 3600.0           # m³/s (ex.: 10 m³/h)\n\n# rho_in = 900.0  # kg/m³ (ajuste para o óleo/água)\n# Q_in = (G('FC002.pv', 10.0) / 3.6) / rho_in  # t/h -> kg/s -> m³/s\n\n# MV do controlador de nível (cascata) — usa valor do passo anterior\nmv_prev = passado('LC001.pv', 1, 0.0)         # %\n\n# Capacidade da linha/saída: lei hidráulica simples (√h) limitada por k_v\nQ_out_max = k_v * math.sqrt(max(h_prev, 0.0)) # m³/s em 100%\nQ_out = Q_out_max * max(0.0, min(1.0, mv_prev/100.0))\n\n# Balanço de volume\ndh = (Q_in - Q_out) / max(1e-9, A)\nvalor = max(0.0, h_prev + dt*dh)              # trava nível ≥ 0",
                    "controle": {
                        "variavel_controlada": true,
                        "Kp": 1.0,
                        "Ki": 0.0,
                        "Kd": 0.0,
                        "modo": "MAN",
                        "sp_tracking": true,
                        "pv_tag": "LI001.pv",
                        "sp_tag": "LI001.sp",
                        "mv_tag": "LI001.mv",
                        "acao": "reversa",
                        "mv_write_tag": "LC001.mv",
                        "pv_min": 0.0,
                        "pv_max": 100.0
                    },
                    "alarmes": {
                        "HH": null,
                        "H": null,
                        "L": null,
                        "LL": null
                    },
                    "mods": []
                },
                {
                    "type": "variavel",
                    "x": 428.0978924144533,
                    "y": 487.4379125437458,
                    "tag": "FC001",
                    "casas": 0,
                    "digitos": 4,
                    "z": 0.0,
                    "color": "#000000",
                    "font": "Microsoft Sans Serif,12,-1,5,50,0,0,0,0,0",
                    "id": 2357715342048,
                    "lei": "valor = 5000+random.uniform(0, 75)",
                    "controle": {
                        "variavel_controlada": false,
                        "Kp": 1.0,
                        "Ki": 0.0,
                        "Kd": 0.0,
                        "modo": "MAN",
                        "sp_tracking": false,
                        "pv_tag": "FC001.pv",
                        "sp_tag": "FC001.sp",
                        "mv_tag": "FC001.mv",
                        "acao": "direta",
