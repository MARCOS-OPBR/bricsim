                                                "rhs": "G(\"FC001MV.Cv_max\",14000.0)* ( ( G(\"FC001MV.R\",50.0) ** CLAMP(G(\"FC001MV.mv_iq\", G(\"FC001MV.mv\",0.0))/100.0, 0.0, 1.0) - 1.0 ) / ( G(\"FC001MV.R\",50.0) - 1.0 ) )",
