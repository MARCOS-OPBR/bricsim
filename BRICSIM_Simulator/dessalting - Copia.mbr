                },
                {
                    "type": "variavel",
                    "x": 706.3017642090622,
                    "y": 488.2073851438116,
                    "tag": "TI001",
                    "casas": 0,
                    "digitos": 4,
                    "z": 0.0,
                    "color": "#000000",
                    "font": "Microsoft Sans Serif,12,-1,5,50,0,0,0,0,0",
                    "id": 2357715341904,
                    "lei": "# TI_MIST: temperatura de mistura (óleo + água)\n# Vazões em m³/s, T em °C. Mistura sem troca de fase.\n# Dinâmica de 1ª ordem (tau) a partir de T_target (média ponderada por m·cp)\n\ndt   = 1.0      # s\ntau  = 15.0     # s  (deixe maior se quiser resposta mais lenta)\n\n# Propriedades \"típicas\" (ajuste se tiver dados da sua corrente)\nrho_o = 800.0   # kg/m³ (óleo)\ncp_o  = 2.1     # kJ/(kg·K)\nrho_w = 1000.0  # kg/m³ (água)\ncp_w  = 4.18    # kJ/(kg·K)\n\n# Leituras das correntes\nF_o  = G('FC001.pv', 3000)   # m³/s de óleo\nT_o  = G('TI_OLEO.pv', 95)   # °C do óleo\nF_w  = G('F_AGUA.pv', 650)   # m³/s de água\nT_w  = G('TI003.pv', 28.0)   # °C da água\n\n# Vazões mássicas\nm_o = max(0.0, F_o) * rho_o\nm_w = max(0.0, F_w) * rho_w\n\n# Evita divisão por zero: se não há fluxo total, mantém última temperatura\nden = m_o*cp_o + m_w*cp_w\nif den <= 1e-9:\n    valor = passado('TI001.pv', 1, 28.0)\nelse:\n    T_target = (m_o*cp_o*T_o + m_w*cp_w*T_w) / den\n    T_prev   = passado('TI001.pv', 1, 28.0)\n    valor    = T_prev + dt/tau * (T_target - T_prev)",
                    "controle": {
                        "variavel_controlada": false,
                        "Kp": 1.0,
                        "Ki": 0.0,
                        "Kd": 0.0,
                        "modo": "MAN",
                        "sp_tracking": false,
                        "pv_tag": "TI001.pv",
                        "sp_tag": "TI001.sp",
                        "mv_tag": "TI001.mv",
                        "acao": "direta",
                        "mv_write_tag": "",
                        "pv_min": 0.0,
                        "pv_max": 150.0
                    },
                    "alarmes": {
                        "HH": null,
                        "H": null,
                        "L": null,
                        "LL": null
                    },
                    "mods": []
                },
                {
                    "type": "variavel",
                    "x": 564.2975241334473,
                    "y": 461.9754743708188,
                    "tag": "TI003",
                    "casas": 0,
                    "digitos": 4,
                    "z": 0.0,
                    "color": "#000000",
                    "font": "Microsoft Sans Serif,12,-1,5,50,0,0,0,0,0",
                    "id": 2357715341760,
                    "lei": "# TI003: temperatura proporcional à vazão de vapor FC002 (t/h)\n# parte de 28 °C e responde com 1ª ordem\n\ndt        = 1.0          # passo [s]\ntau       = 20.0         # constante de tempo [s] (ajuste)\nKT_deg_th = 27         # ganho: °C por (t/h)  (ajuste)\n\nT_prev = passado('TI003.pv', 1, 28.0)\nF_th   = G('FC002.pv', 0.0)      # vazão de vapor em t/h (como você definiu)\n\nT_target = 28.0 + KT_deg_th * F_th    # relação proporcional simples\n# (opcional) limites de engenharia para evitar valores absurdos:\nT_target = max(0.0, min(300.0, T_target))\n\n# dinâmica 1ª ordem (evita loop algébrico e dá inércia física)\nvalor = T_prev + dt/tau * (T_target - T_prev)",
                    "controle": {
                        "variavel_controlada": false,
                        "Kp": 1.0,
                        "Ki": 0.0,
                        "Kd": 0.0,
                        "modo": "MAN",
                        "sp_tracking": false,
                        "pv_tag": "TI003.pv",
                        "sp_tag": "TI003.sp",
                        "mv_tag": "TI003.mv",
                        "acao": "direta",
                        "mv_write_tag": "",
                        "pv_min": 0.0,
                        "pv_max": 150.0
                    },
                    "alarmes": {
                        "HH": null,
                        "H": null,
                        "L": null,
                        "LL": null
                    },
                    "mods": []
                },
