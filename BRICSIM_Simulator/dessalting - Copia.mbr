                {
                    "type": "variavel",
                    "x": 404.45484006517484,
                    "y": 893.421033526831,
                    "tag": "SAL000",
                    "casas": 0,
                    "digitos": 3,
                    "z": 0.0,
                    "color": "#000000",
                    "font": "Microsoft Sans Serif,12,-1,5,50,0,0,0,0,0",
                    "id": 2357715342912,
                    "lei": "valor = 350",
                    "controle": {
                        "variavel_controlada": false,
                        "Kp": 1.0,
                        "Ki": 0.0,
                        "Kd": 0.0,
                        "modo": "MAN",
                        "sp_tracking": false,
                        "pv_tag": "SAL000.pv",
                        "sp_tag": "SAL000.sp",
                        "mv_tag": "SAL000.mv",
                        "acao": "direta",
                        "mv_write_tag": "",
                        "pv_min": 0.0,
                        "pv_max": 500.0
                    },
                    "alarmes": {
                        "HH": null,
