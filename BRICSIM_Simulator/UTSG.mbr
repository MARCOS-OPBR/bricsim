                                        "rhs": "( lambda Lpct, Hmax, ptop, Ks, Qref, Qprev, xv:\n    ptop\n  + G(\"HY.Hm\",0.10) * Hmax * (CLAMP(Lpct,0.0,100.0)/100.0)                  # coluna\n  - Ks * ( max(Qprev,0.0) / max(1e-6, Qref) )**2 / max(0.05, xv**2)          # perda sucção\n)(\n  G(\"V001.L\", 50.0), G(\"V001.HMAX\",2.5), G(\"V001.PTOP\",1.0),\n  G(\"B01A.Ksuc\",0.6), G(\"B01A.QREF\",600.0),\n  passado(\"B01A.Q\",1,0.0),\n  CLAMP(G(\"XV001.PV5\",1), 0.0, 1.0)\n)",
                                        "type": "equation"
                                    },
                                    {
                                        "enabled": true,
                                        "id": "e0ecf8b1-fc46-447b-a4c1-044bff19c99f",
                                        "lhs": "B01A.CAV",
                                        "name": "B01A_cav",
                                        "rhs": "CLAMP( ( G(\"B01A.Psuc\",1.0) - G(\"HY.Pvap\",0.10) ) / 0.40, 0.0, 1.0 )",
                                        "type": "equation"
                                    },
                                    {
                                        "enabled": true,
                                        "id": "8d10aaae-d26b-4c2a-8d3b-9504938f12cf",
                                        "lhs": "B01A.Pdest",
                                        "name": "B01A_Pdest",
                                        "rhs": "( lambda ptop2, L2, Hmax2, Kd, Qref, Qprev:\n    ptop2 + G(\"HY.Hm\",0.10)*Hmax2*(CLAMP(L2,0.0,100.0)/100.0)\n    + Kd * ( max(Qprev,0.0) / max(1e-6, Qref) )**2\n)(\n  G(\"PTOP.pv\",1.0), G(\"LC001.pv\",50.0), G(\"V002.HMAX\",3.0),\n  G(\"B01A.Kdis\",0.8), G(\"B01A.QREF\",600.0),\n  passado(\"B01A.Q\",1,0.0)\n)",
                                        "type": "equation"
                                    },
                                    {
                                        "enabled": true,
                                        "id": "531101e8-c113-41dd-bf22-fe3af0f2d601",
                                        "lhs": "B01A.Qtarget",
                                        "name": "B01A_Qtarget",
                                        "rhs": "( lambda H0, Qmax, N, CAV, Ps, Pd:\n    Qmax * CLAMP(N,0.0,1.0) * math.sqrt(\n      max( 1.0 - max(Pd - Ps, 0.0) / max(1e-6, H0*(CLAMP(N,0.0,1.0)**2)*CLAMP(CAV,0.0,1.0) ), 0.0 )\n    )\n)(\n  G(\"B01A.H0\",12.0), G(\"B01A.QMAX\",800.0), CLAMP(G(\"B01A.mv\",0.0)/100.0,0.0,1.0), G(\"B01A.CAV\",1.0),\n  G(\"B01A.Psuc\",1.0), G(\"B01A.Pdest\",1.5)\n)",
                                        "type": "equation"
                                    },
                                    {
                                        "enabled": true,
                                        "id": "3259d3c3-4625-42db-ac6d-adc8cffd7135",
                                        "lhs": "B01A.Q",
                                        "name": "B01A_Qdyn",
                                        "rhs": "RAMP( passado(\"B01A.Q\",1,0.0), G(\"B01A.Qtarget\",0.0), dt, 2.0 )",
                                        "type": "equation"
                                    },
                                    {
                                        "enabled": true,
                                        "id": "d99613f6-3a32-4c4d-a68e-efa7cd7640e8",
                                        "lhs": "PI001.pv",
                                        "name": "PI001_discharge",
                                        "rhs": "G(\"B01A.Psuc\",1.0) + G(\"B01A.H0\",12.0)*(CLAMP(G(\"HSB01A.PV5\",0.0)/100.0,0.0,1.0)**2)*CLAMP(G(\"B01A.CAV\",1.0),0.0,1.0) * (1.0 - (G(\"B01A.Q\",0.0)/max(1e-9,G(\"B01A.QMAX\",800.0)))**2)",
                                        "type": "equation"
                                    },
                                    {
                                        "enabled": true,
                                        "id": "0818ed05-eda5-4f14-8897-cbdd469d6474",
                                        "lhs": "B01B.Psuc",
                                        "name": "B01B_Psuc",
                                        "rhs": "( lambda Lpct, Hmax, ptop, Ks, Qref, Qprev, xv:\n    ptop\n  + G(\"HY.Hm\",0.10) * Hmax * (CLAMP(Lpct,0.0,100.0)/100.0)                  # coluna\n  - Ks * ( max(Qprev,0.0) / max(1e-6, Qref) )**2 / max(0.05, xv**2)          # perda sucção\n)(\n  G(\"V001.L\", 50.0), G(\"V001.HMAX\",2.5), G(\"V001.PTOP\",1.0),\n  G(\"B01B.Ksuc\",0.6), G(\"B01B.QREF\",600.0),\n  passado(\"B01B.Q\",1,0.0),\n  CLAMP(G(\"XV001.mv\",100.0)/100.0, 0.0, 1.0)\n)",
                                        "type": "equation"
                                    },
