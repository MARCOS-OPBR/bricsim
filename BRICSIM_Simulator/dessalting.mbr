                                        "children": [
                                            {
                                                "enabled": true,
                                                "id": "04090ac1-dd54-4ad6-8b61-970bc8ebe78e",
                                                "lhs": "TI003.filt",
                                                "name": "TI003_filtro",
                                                "rhs": "( lambda prev, x, tau:  prev + (dt/(tau+dt))*(x - prev))( passado(\"TI003.filt\",1, G(\"TI003.pv\",31.0)), G(\"TI003.pv\",31.0), 4.0 )",
                                                "type": "equation"
                                            },
                                            {
                                                "enabled": true,
                                                "id": "a0d6c98e-85d8-434d-8b58-201d6c9c2045",
                                                "lhs": "TI003.target",
                                                "name": "TI003_target_steam",
                                                "rhs": "( lambda Ti2, Cw, md, lam, UA, Ts:\n    ( lambda Q_UA, Q_MAX, Q:\n        CLAMP( Ti2 + Q / max(1e-6, Cw), min(Ti2, Ts), Ts )\n    )( UA * max(Ts - Ti2, 0.0),\n       md * lam,\n       min( UA * max(Ts - Ti2, 0.0), md * lam ) )\n)( G(\"TI002.pv\",31.0), G(\"HX.Cw\",0.0), G(\"STEAM.mdot\",0.0), G(\"STEAM.lambda\",2000.0), G(\"STEAM.UA\",100.0), G(\"STEAM.Ts\",180.0) )",
                                                "type": "equation"
                                            },
                                            {
                                                "enabled": true,
                                                "id": "5230f994-1cf7-45ba-a0b3-354e2dac9412",
                                                "lhs": "TI003.pv",
                                                "name": "TI003_dyn",
                                                "rhs": "( lambda prev, alvo, tau:\n  prev + (dt/(tau + dt)) * (alvo - prev)\n)( passado(\"TI003.pv\",1,31.0), G(\"TI003.target\",31.0), 30 )",
                                                "type": "equation"
                                            },
