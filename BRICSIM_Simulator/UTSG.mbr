                                        "lhs": "B01B.CAV",
                                        "name": "B01B_cav",
                                        "rhs": "CLAMP( ( G(\"B01B.Psuc\",1.0) - G(\"HY.Pvap\",0.10) ) / 0.40, 0.0, 1.0 )",
                                        "type": "equation"
                                    },
                                    {
                                        "enabled": true,
