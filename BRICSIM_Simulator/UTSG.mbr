                                        "rhs": "( lambda ptop2, L2, Hmax2, Kd, Qref, Qprev:\n    ptop2 + G(\"HY.Hm\",0.10)*Hmax2*(CLAMP(L2,0.0,100.0)/100.0)\n    + Kd * ( max(Qprev,0.0) / max(1e-6, Qref) )**2\n)(\n  G(\"PTOP.pv\",1.0), G(\"LC001.pv\",50.0), G(\"V002.HMAX\",3.0),\n  G(\"B01B.Kdis\",0.8), G(\"B01B.QREF\",600.0),\n  passado(\"B01B.Q\",1,0.0)\n)",
                                        "type": "equation"
                                    },
                                    {
                                        "enabled": true,
                                        "id": "c43b47db-6b33-4035-a9ea-33e56c91012a",
                                        "lhs": "B01B.Qtarget",
                                        "name": "B01B_Qtarget",
                                        "rhs": "( lambda H0, Qmax, N, CAV, Ps, Pd:\n    Qmax * CLAMP(N,0.0,1.0) * math.sqrt(\n      max( 1.0 - max(Pd - Ps, 0.0) / max(1e-6, H0*(CLAMP(N,0.0,1.0)**2)*CLAMP(CAV,0.0,1.0) ), 0.0 )\n    )\n)(\n  G(\"B01B.H0\",12.0), G(\"B01B.QMAX\",800.0), CLAMP(G(\"B01B.mv\",0.0)/100.0,0.0,1.0), G(\"B01B.CAV\",1.0),\n  G(\"B01B.Psuc\",1.0), G(\"B01B.Pdest\",1.5)\n)",
                                        "type": "equation"
