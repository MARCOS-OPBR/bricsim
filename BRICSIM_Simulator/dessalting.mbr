                                                "name": "TI001_tau_eff",
                                                "rhs": "G(\"TI001.TAU_MIN\",6.0) + G(\"TI001.TAU_MAX\",10.0) * ( G(\"TI001.Cref\",20.0) / ( G(\"TI001.Cref\",20.0) + max(1e-6, G(\"HX.Cw\",0.0) + G(\"HX.Co\",0.0)) ) )",
