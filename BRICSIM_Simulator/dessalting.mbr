                {
                    "type": "variavel",
                    "x": 1157.2879650651746,
                    "y": 443.24203352683116,
                    "tag": "VI001",
                    "casas": 2,
                    "digitos": 4,
                    "z": 0.0,
                    "color": "#000000",
                    "font": "Microsoft Sans Serif,12,-1,5,50,0,0,0,0,0",
                    "id": 2617092809232,
                    "lei": "# ---- Parâmetros de referência\nV_ref   = 440.0      # V nominal\nNivel_ref = 40     # % (nível de referência)\nAPI_ref   = 30.0     # API de referência\nT_ref     = 105    # °C de referência (TI001)\nk         =1      # fator de ajuste global\n\n# ---- Leituras atuais\nnivel = G('LI001.pv', 0)    # m\napi   = G('API001.pv', API_ref)      # ºAPI\ntemp  = G('TI001.pv', T_ref)            # °C\nV_ant=passado(\"VI001.pv\",1,0)\n# ---- Relação física simplificada\nvalor =V_ant+0.1*(V_ref * (temp/T_ref)  * (Nivel_ref/nivel) * (api/API_ref) * k - V_ant)\n# ou mais simples: valor = V_ref * (temp/T_ref) * (Nivel_ref/nivel) * (API_ref/api)\n\n# ---- Limites de engenharia\nvalor = max(0.0, min(500.0, valor))",
                    "controle": {
                        "variavel_controlada": false,
                        "Kp": 1.0,
                        "Ki": 0.0,
                        "Kd": 0.0,
                        "modo": "MAN",
                        "sp_tracking": false,
                        "pv_tag": "VI001.pv",
                        "sp_tag": "VI001.sp",
                        "mv_tag": "VI001.mv",
                        "acao": "direta",
                        "mv_write_tag": "",
                        "pv_min": 0.0,
                        "pv_max": 500.0
                    },
                    "alarmes": {
                        "HH": null,
                        "H": null,
                        "L": null,
                        "LL": null
                    },
                    "tipo": "ANA",
                    "mods": []
                },
                {
                    "type": "variavel",
                    "x": 1157.2879650651748,
                    "y": 481.2639085268311,
                    "tag": "II001",
                    "casas": 2,
                    "digitos": 4,
                    "z": 0.0,
                    "color": "#000000",
                    "font": "Microsoft Sans Serif,12,-1,5,50,0,0,0,0,0",
                    "id": 2617092809088,
                    "lei": "# ---- Parâmetros\nI_ref = 25.0     # A nominal\nV_nom = 440.0    # V nominal para I_ref\n\n# ---- Leitura da tensão calculada\nV_atual = G('VI001.pv', V_nom)   # V\n\n# ---- Relação inversa\nvalor = I_ref * (V_nom / max(1e-6, V_atual))*1.2",
                    "controle": {
                        "variavel_controlada": false,
                        "Kp": 1.0,
                        "Ki": 0.0,
