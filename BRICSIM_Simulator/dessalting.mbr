                {
                    "type": "variavel",
                    "x": 308.63971506517487,
                    "y": 564.9120335268309,
                    "tag": "FC001MV",
                    "casas": 2,
                    "digitos": 4,
                    "z": 0.0,
                    "color": "#000000",
                    "font": "Microsoft Sans Serif,12,-1,5,50,0,0,0,0,0",
                    "id": 2617092809952,
                    "lei": "# ----- FC003.mv_iq: fecha a válvula quando a bomba parar -----\nRUN_BOMBA = G(\"BOMBA001.PV5\", 0)   # 1=rodando, 0=parada\nmv_prev   = passado(\"TC001.mv_iq\", 1, 0.0)\n\n# alvo: 0% se parada, senão \"não interfere\" (use -1 como nulo)\nmv_target = 0.0 if (RUN_BOMBA == 0) else -1.0\n\n# rampa curta só pra não “dar tranco” (opcional)\nDT     = 1.0\ntau    = 2.0\nmv_next = mv_prev + (DT/tau)*((mv_target if mv_target>=0 else mv_prev) - mv_prev)\n\n# se alvo nulo (-1), mantenha último; se alvo 0, aplique clamp 0..100\nif mv_target < 0:\n    valor = mv_prev\nelse:\n    if mv_next < 0.0:   mv_next = 0.0\n    if mv_next > 100.0: mv_next = 100.0\n    valor = mv_next",
                    "controle": {
                        "variavel_controlada": false,
                        "Kp": 1.0,
                        "Ki": 0.0,
                        "Kd": 0.0,
                        "modo": "MAN",
                        "sp_tracking": false,
