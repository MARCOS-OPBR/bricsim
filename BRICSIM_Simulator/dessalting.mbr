                        "modo": "MAN",
                        "sp_tracking": false,
                        "pv_tag": "API001.pv",
                        "sp_tag": "API001.sp",
                        "mv_tag": "API001.mv",
                        "acao": "direta",
                        "mv_write_tag": "",
                        "pv_min": 0.0,
                        "pv_max": 100.0
                    },
                    "alarmes": {
